{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emergent-matter.example/schemas/sdm-0.1.schema.json",
    "title": "SDM Part",
    "description": "Source-of-truth file format for a manufactured part.",
    "type": "object",
    "required": ["schema_version", "name"],
    "additionalProperties": false,
    "properties": {
      "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
      "name": { "type": "string", "minLength": 1 },
      "metadata": { "type": "object" },
      "params": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/param" }
      },
      "materials": {
        "type": "array",
        "items": { "$ref": "#/$defs/material" }
      },
      "couplings": {
        "type": "array",
        "items": { "$ref": "#/$defs/coupling" }
      },
      "objectives": {
        "type": "array",
        "items": { "$ref": "#/$defs/objective" }
      },
      "constraints": {
        "type": "array",
        "items": { "$ref": "#/$defs/constraint" }
      },
      "history": {
        "type": "array",
        "items": { "type": "object" }
      }
    },
  
    "$defs": {
      "param": {
        "type": "object",
        "required": ["name", "value", "unit"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "free": { "type": "boolean" },
          "bounds": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "unit": {
            "enum": [
              "mm", "mm^2", "mm^3",
              "rad", "deg",
              "count", "ratio",
              "g", "kg", "g/mm^3", "kg/m^3",
              "N", "N/mm", "N*mm", "N*mm/rad",
              "MPa", "GPa",
              "s", "Hz"
            ]
          },
          "ui": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step": { "type": "number", "exclusiveMinimum": 0 },
              "explore_bounds": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 2,
                "maxItems": 2
              },
              "group": { "type": "string" },
              "order": { "type": "number" },
              "role": { "enum": ["topology", "pose"] },
              "collapsed": { "type": "boolean" },
              "driven": { "type": "boolean" },
              "choices": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 2
              }
            }
          }
        }
      },
  
      "material": {
        "type": "object",
        "required": ["material_id", "name", "sdf_tree"],
        "additionalProperties": false,
        "properties": {
          "material_id": { "type": "integer" },
          "name": { "type": "string", "minLength": 1 },
          "sdf_tree": { "$ref": "#/$defs/sdf" }
        }
      },
  
      "coupling": {
        "type": "object",
        "required": ["name", "position"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "position": { "$ref": "#/$defs/vec3" },
          "normal": { "$ref": "#/$defs/vec3" },
          "sdf_tree": { "$ref": "#/$defs/sdfOrNull" },
          "metadata": { "type": "object" }
        }
      },
  
      "objective": {
        "type": "object",
        "required": ["name", "sense", "expr"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sense": { "enum": ["minimize", "maximize"] },
          "expr": { "$ref": "#/$defs/expr" },
          "weight": { "type": "number" }
        }
      },
  
      "constraint": {
        "type": "object",
        "required": ["name", "expr", "op", "rhs"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expr": { "$ref": "#/$defs/expr" },
          "op": { "enum": ["<=", ">=", "==", "<", ">"] },
          "rhs": { "type": "number" },
          "tolerance": { "type": "number" }
        }
      },
  
      "vec3": {
        "type": "array",
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 3
      },
  
      "sdfOrNull": {
        "oneOf": [
          { "type": "null" },
          { "$ref": "#/$defs/sdf" }
        ]
      },
  
      "sdf": {
        "type": "object",
        "required": ["type"],
        "unevaluatedProperties": false,
        "oneOf": [
          {
            "properties": {
              "type": { "const": "primitive" },
              "kind": { "type": "string", "minLength": 1 },
              "params": { "type": "object" }
            },
            "required": ["kind"]
          },
          {
            "properties": {
              "type": { "const": "op" },
              "op": {
                "enum": [
                  "union", "subtract", "intersect",
                  "smooth_union", "smooth_subtract", "smooth_intersect",
                  "softmin_many", "softmin_chunked"
                ]
              },
              "children": {
                "type": "array",
                "items": { "$ref": "#/$defs/sdf" },
                "minItems": 1
              },
              "params": { "type": "object" }
            },
            "required": ["op", "children"]
          },
          {
            "properties": {
              "type": { "const": "transform" },
              "transform": {
                "enum": [
                  "translate", "scale",
                  "rotate_x", "rotate_y", "rotate_z", "rotate_matrix",
                  "repeat_inf", "repeat_finite",
                  "canonical_sector_fold", "mirror"
                ]
              },
              "child": { "$ref": "#/$defs/sdf" },
              "params": { "type": "object" }
            },
            "required": ["transform", "child"]
          },
          {
            "properties": {
              "type": { "const": "modifier" },
              "modifier": { "type": "string", "minLength": 1 },
              "child": { "$ref": "#/$defs/sdf" },
              "params": { "type": "object" }
            },
            "required": ["modifier", "child"]
          },
          {
            "properties": {
              "type": { "const": "deform" },
              "deform": { "type": "string", "minLength": 1 },
              "child": { "$ref": "#/$defs/sdf" },
              "field": { "$ref": "#/$defs/field" },
              "params": { "type": "object" }
            },
            "required": ["deform", "child"]
          },
          {
            "properties": {
              "type": { "const": "2d_to_3d" },
              "method": { "type": "string", "minLength": 1 },
              "child": { "$ref": "#/$defs/sdf" },
              "params": { "type": "object" }
            },
            "required": ["method", "child"]
          },
          {
            "properties": {
              "type": { "const": "sweep" },
              "child": { "$ref": "#/$defs/sdf" },
              "params": { "type": "object" }
            },
            "required": ["child", "params"]
          },
          {
            "properties": {
              "type": { "const": "loft" },
              "children": {
                "type": "array",
                "items": { "$ref": "#/$defs/sdf" },
                "minItems": 2
              },
              "params": { "type": "object" }
            },
            "required": ["children", "params"]
          }
        ]
      },
  
      "field": {
        "type": "object",
        "required": ["type"],
        "unevaluatedProperties": false,
        "oneOf": [
          {
            "properties": {
              "type": { "const": "field" },
              "kind": { "type": "string", "minLength": 1 },
              "params": { "type": "object" }
            },
            "required": ["kind"]
          },
          {
            "properties": {
              "type": { "const": "field_op" },
              "op": { "type": "string", "minLength": 1 },
              "children": {
                "type": "array",
                "items": { "$ref": "#/$defs/field" },
                "minItems": 1
              },
              "params": { "type": "object" }
            },
            "required": ["op", "children"]
          }
        ]
      },
  
      "expr": {
        "type": "object",
        "required": ["type"],
        "unevaluatedProperties": false,
        "oneOf": [
          {
            "properties": {
              "type": { "const": "num" },
              "value": { "type": "number" }
            },
            "required": ["value"]
          },
          {
            "properties": {
              "type": { "const": "param" },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["name"]
          },
          {
            "properties": {
              "type": { "const": "metric" },
              "name": { "type": "string", "minLength": 1 },
              "args": { "type": "object" }
            },
            "required": ["name"]
          },
          {
            "properties": {
              "type": { "const": "unop" },
              "op": { "enum": ["neg", "abs", "sqrt", "log", "exp", "square"] },
              "child": { "$ref": "#/$defs/expr" }
            },
            "required": ["op", "child"]
          },
          {
            "properties": {
              "type": { "const": "binop" },
              "op": { "enum": ["+", "-", "*", "/", "pow", "min", "max"] },
              "lhs": { "$ref": "#/$defs/expr" },
              "rhs": { "$ref": "#/$defs/expr" }
            },
            "required": ["op", "lhs", "rhs"]
          },
          {
            "properties": {
              "type": { "const": "reduce" },
              "op": { "enum": ["sum", "mean", "min", "max"] },
              "children": {
                "type": "array",
                "items": { "$ref": "#/$defs/expr" },
                "minItems": 1
              }
            },
            "required": ["op", "children"]
          }
        ]
      }
    }
  }
  
      "ui": {
        "step": 0.5,
        "group": "hinge",
        "order": 1
      }
    },
    "beam_depth": {
      "name": "beam_depth",
      "value": 8.0,
      "free": false,
      "bounds": [
        2.0,
        20.0
      ],
      "unit": "mm",
      "ui": {
        "step": 0.5,
        "group": "hinge",
        "order": 2
      }
    },
    "notch_radius": {

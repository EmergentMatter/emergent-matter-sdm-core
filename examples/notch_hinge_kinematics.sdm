              "params": {
                "b": [
                  8.0,
                  4.0,
                  8.0
                ]
              }
            },
            "params": {
              "t": [
                12.0,
                0.0,
                0.0
              ]
            },
            "name": "block_moving"
          }
        ]
      }
    }
  ],
